<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ ignores fullBackupContent and uses these rules instead, for both
  cloud backup and device-to-device transfer. Same exclusions as
  backup_rules.xml: the secure-storage files are useless once restored, because
  the Keystore key that unwraps them does not travel with them.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="FlutterSecureKeyStorage.xml"/>
        <exclude domain="sharedpref" path="FlutterSecureStorageConfiguration:FlutterSecureStorage.xml"/>
        <exclude domain="sharedpref" path="FlutterSecureStorage.xml"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="FlutterSecureKeyStorage.xml"/>
        <exclude domain="sharedpref" path="FlutterSecureStorageConfiguration:FlutterSecureStorage.xml"/>
        <exclude domain="sharedpref" path="FlutterSecureStorage.xml"/>
    </device-transfer>
</data-extraction-rules>
